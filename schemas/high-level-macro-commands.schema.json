{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesis-engine.local/schema/high-level-macro-commands.json",
  "title": "Genesis High-Level Macro Commands",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "commands": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "const": "GenerateGameLoop"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "genre": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "pacing": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "win_condition": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "director_rules": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "maxLength": 64
                    }
                  }
                },
                "required": [
                  "genre",
                  "pacing",
                  "win_condition",
                  "director_rules"
                ]
              }
            },
            "required": [
              "command",
              "payload"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "const": "SetWorldState"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "faction_control": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "time_limit_mins": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 180
                  },
                  "current_location": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "alert_level": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "faction_control",
                  "time_limit_mins"
                ]
              }
            },
            "required": [
              "command",
              "payload"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "commands"
  ]
}
