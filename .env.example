# Optional authoritative multiplayer WebSocket endpoint.
# Examples:
# VITE_MULTIPLAYER_URL=ws://localhost:2567
# VITE_MULTIPLAYER_URL=wss://play.example.com/ws
VITE_MULTIPLAYER_URL=

# Unity WebGL build files served by the React app or a CDN.
VITE_UNITY_LOADER_URL=/unity-build/build.loader.js
VITE_UNITY_DATA_URL=/unity-build/build.data
VITE_UNITY_FRAMEWORK_URL=/unity-build/build.framework.js
VITE_UNITY_CODE_URL=/unity-build/build.wasm

# Unreal Engine 5 AI command WebSocket server.
VITE_UNREAL_WS_URL=ws://localhost:3002

# Universal binary Protobuf state/command bus.
VITE_UNIVERSAL_WS_URL=ws://localhost:3010
UNIVERSAL_TRANSPORT_PORT=3010

# Server-side LLM provider.
# Supported values: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_VISION_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
